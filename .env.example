# Postgres trên Railway (pgvector + pg_trgm), URL public proxy: KB và dữ liệu ca (T139).
DATABASE_URL=
# Redis trên Railway (Redis 8, có search + JSON), URL public proxy: checkpoint của ca, TTL 24 giờ (T139).
REDIS_URL=

# Gateway LiteLLM của DBIZ Autonomous (OpenAI-compatible), dùng virtual key riêng của hpo.
# Model nào cũng phải khai báo tham số riêng trong backend/core/llm_models.toml.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=embedding
COLBERT_MODEL=embedding-colbert

# Langfuse (eval + tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
