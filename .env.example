DATABASE_URL=postgresql://hpo:hpo@localhost:5433/hpo

# State tạm của từng ca (checkpointer LangGraph, TTL 24 giờ, T92)
REDIS_URL=redis://localhost:6380

# Gateway LiteLLM của DBIZ Autonomous (OpenAI-compatible), dùng virtual key riêng của hpo.
# Model nào cũng phải khai báo tham số riêng trong backend/llm_models.toml.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=embedding
COLBERT_MODEL=embedding-colbert

# Langfuse (eval + tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
